<Project Sdk="WixToolset.Sdk">
  <PropertyGroup>
    <OutputName>winpepper-$(Version)-x64</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- ICE60 suppressed by Plan 6 default. ICE03 added because heat-harvested
         DLLs from the WinAppSDK self-contained publish carry non-MSI-friendly
         Language metadata that the validator rejects. The files install
         correctly; the validation is cosmetic. -->
    <!-- ICE38/ICE64/ICE91 are the documented per-user-install ICEs: file-keypath
         components under a user-profile dir (LocalAppDataFolder) trip ICE38
         (error) + ICE64/ICE91 (warnings). This is inherent to per-user installs
         and cannot be fixed by scope; suppressing them is the standard remedy.
         ICE43 is NOT suppressed (it does not fire: StartMenuShortcut has an HKCU
         keypath; the exe is a File component, not a non-advertised shortcut). -->
    <SuppressIces>ICE60;ICE03;ICE69;ICE38;ICE64;ICE91</SuppressIces>
    <OutputPath>$(MSBuildThisFileDirectory)..\artifacts\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\$(Configuration)\</IntermediateOutputPath>
    <AppPublishDir Condition=" '$(AppPublishDir)' == '' ">$(MSBuildThisFileDirectory)..\src\Winpepper.App\bin\$(Configuration)\net9.0-windows10.0.19041.0\win-x64\publish</AppPublishDir>
  </PropertyGroup>
  <!-- WSL builds (repo on a \\wsl.localhost UNC path): wix.exe drives msi.dll,
       and the Windows Installer service cannot see the per-user 9p share, so
       linking/validating an MSI on the UNC path fails with MsiException 1631.
       Stage obj/bin on the local drive (stable, reused dir under %TEMP%) and
       copy the final MSI back to artifacts\ (_WinpepperCopyMsiToArtifacts
       below). Inert on normal C:\ checkouts / CI: the StartsWith('\\')
       condition is false there. -->
  <PropertyGroup Condition="$(MSBuildThisFileDirectory.StartsWith('\\'))">
    <WinpepperUncStagingDir>$(TEMP)\winpepper-msi\</WinpepperUncStagingDir>
    <OutputPath>$(WinpepperUncStagingDir)bin\</OutputPath>
    <IntermediateOutputPath>$(WinpepperUncStagingDir)obj\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <D3D12ProbeExe>$(MSBuildThisFileDirectory)probes\bin\$(Configuration)\publish\Winpepper.D3D12Probe.exe</D3D12ProbeExe>
    <WinAppSdkBootstrapper Condition="'$(WinAppSdkBootstrapper)' == ''">$(MSBuildThisFileDirectory)bootstrapper\WindowsAppRuntimeInstall-x64.exe</WinAppSdkBootstrapper>
  </PropertyGroup>
  <PropertyGroup>
    <DefineConstants>AppPublishDir=$(AppPublishDir);D3D12ProbeExe=$(D3D12ProbeExe);WinAppSdkBootstrapper=$(WinAppSdkBootstrapper)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
    <PackageReference Include="WixToolset.Util.wixext" />
    <!-- WixToolset.Heat provides the HarvestDirectory MSBuild item / Heat target.
         In WiX v5 the SDK no longer bundles Heat, so it must be referenced explicitly
         for the HarvestDirectory item below to generate the ComponentGroup. -->
    <PackageReference Include="WixToolset.Heat" />
  </ItemGroup>
  <ItemGroup>
    <HarvestDirectory Include="$(AppPublishDir)">
      <ComponentGroupName>HarvestedFiles</ComponentGroupName>
      <DirectoryRefId>INSTALLFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <PreprocessorVariable>var.AppPublishDir</PreprocessorVariable>
      <!-- Heat's MSBuild item has no ExcludeFiles metadata; we strip Winpepper.exe
           from the harvested ComponentGroup with an XSL transform so it does not
           collide with the hand-authored WinpepperExeAlias in winpepper.wxs. -->
      <Transforms>$(MSBuildThisFileDirectory)exclude-winpepper-exe.xsl</Transforms>
    </HarvestDirectory>
  </ItemGroup>
  <ItemGroup>
    <BindPath Include="$(AppPublishDir)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\Winpepper.App\Winpepper.App.csproj">
      <DoNotHarvest>true</DoNotHarvest>
      <Private>false</Private>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Targets>Publish</Targets>
      <Properties>Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(AppPublishDir)\</Properties>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="probes\Winpepper.D3D12Probe.csproj">
      <Private>false</Private>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Targets>Publish</Targets>
      <Properties>Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;PublishDir=$(MSBuildThisFileDirectory)probes\bin\$(Configuration)\publish\</Properties>
    </ProjectReference>
  </ItemGroup>
  <!-- The self-contained win-x64 publish of Winpepper.App drags in RID-specific
       native assets for every platform shipped by LLamaSharp/ONNX runtime packages
       (runtimes/linux-*, osx-*, win-arm64, win-x86 ~220 MB across ~99 files). Only
       runtimes/win-x64 is ever loadable from an x64 Windows install, so prune the
       rest from the publish output before Heat harvests it. Heat's HarvestDirectory
       target collects its file list in GetHarvestDirectoryContent, so this must run
       first. Kept here (not in the App csproj) so dev builds/publishes are
       unaffected; the ProjectReference re-publishes on each MSI build, so pruning
       the publish dir is safe and repeatable. -->
  <Target Name="PruneNonWinX64Runtimes"
          BeforeTargets="GetHarvestDirectoryContent"
          DependsOnTargets="ResolveProjectReferences"
          Condition="Exists('$(AppPublishDir)\runtimes')">
    <ItemGroup>
      <_PublishRuntimeDir Include="$([System.IO.Directory]::GetDirectories('$(AppPublishDir)\runtimes'))" />
      <_PruneRuntimeDir Include="@(_PublishRuntimeDir)" Condition="'%(Filename)%(Extension)' != 'win-x64'" />
    </ItemGroup>
    <Message Importance="high"
             Condition="'@(_PruneRuntimeDir)' != ''"
             Text="Pruning non-win-x64 runtime assets from publish output: @(_PruneRuntimeDir->'%(Filename)%(Extension)', ', ')" />
    <RemoveDir Directories="@(_PruneRuntimeDir)" />
  </Target>
  <!-- Nerdbank.GitVersioning sets $(Version) in its GetBuildVersion target,
       i.e. at build time; at evaluation time $(Version) is empty, so the
       OutputName declared above expands with an empty version. Re-derive the
       output name (and the file-name properties wix.targets froze from it at
       evaluation) once the real version is known. $(BuildVersion) is NBGV's
       4-part a.b.c.height version - the same value the wxs binds into
       ProductVersion via !(bind.FileVersion.WinpepperExe) - so the filename
       matches the MSI's internal version (winpepper-0.6.2.240-x64.msi style).
       TargetPath itself is recomputed from these by wix.targets'
       AssignTargetPaths, which this target runs before. -->
  <Target Name="_WinpepperVersionedOutputName"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="GetBuildVersion">
    <PropertyGroup Condition="'$(BuildVersion)' != ''">
      <OutputName>winpepper-$(BuildVersion)-x64</OutputName>
      <TargetName>$(OutputName)</TargetName>
      <TargetFileName>$(TargetName)$(TargetExt)</TargetFileName>
      <TargetPdbFileName>$(TargetName).wixpdb</TargetPdbFileName>
      <TargetPdbPath>$(TargetPdbDir)$(TargetPdbFileName)</TargetPdbPath>
    </PropertyGroup>
  </Target>
  <!-- Fresh checkouts: packaging/bootstrapper/ is gitignored, but the wxs
       binds WindowsAppRuntimeInstall-x64.exe into the Binary table. The
       InstallWinAppSdk custom action is gated FALSE (self-contained publish
       ships the runtime; see README "Known issues"), so a text stub satisfies
       the bind without changing behavior - the same stub CI writes in
       ci.yml/nightly.yml. Skipped whenever the file already exists (CI
       creates it - real or stub - before building). -->
  <Target Name="_WinpepperEnsureBootstrapperStub"
          BeforeTargets="CoreCompile"
          Condition="!Exists('$(WinAppSdkBootstrapper)')">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(WinAppSdkBootstrapper)'))" />
    <WriteLinesToFile File="$(WinAppSdkBootstrapper)" Lines="stub" Overwrite="true" Encoding="ASCII" />
    <Message Importance="high" Text="packaging: WindowsAppRuntimeInstall-x64.exe not found; wrote text stub (InstallWinAppSdk custom action is gated FALSE)." />
  </Target>
  <Target Name="SignArtifacts" AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' AND ('$(WinpepperSigningThumbprint)' != '' OR '$(WinpepperSigningPfx)' != '')">
    <PropertyGroup>
      <SignScript>$(MSBuildThisFileDirectory)sign.ps1</SignScript>
      <SignedExe>$(AppPublishDir)\Winpepper.exe</SignedExe>
      <SignedMsi>$(OutputPath)$(OutputName).msi</SignedMsi>
    </PropertyGroup>
    <Exec Condition="'$(WinpepperSigningThumbprint)' != ''"
          Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(SignScript)&quot; -Thumbprint $(WinpepperSigningThumbprint) -InputFiles &quot;$(SignedExe)&quot; &quot;$(SignedMsi)&quot;" />
    <Exec Condition="'$(WinpepperSigningThumbprint)' == '' AND '$(WinpepperSigningPfx)' != ''"
          Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(SignScript)&quot; -PfxPath &quot;$(WinpepperSigningPfx)&quot; -PfxPassword $(WinpepperSigningPfxPassword) -InputFiles &quot;$(SignedExe)&quot; &quot;$(SignedMsi)&quot;" />
  </Target>
  <!-- Counterpart to the WinpepperUncStagingDir redirect above: after a WSL
       (UNC) build, copy the linked (and possibly signed) MSI from the local
       staging dir back to the repo's artifacts\ folder. Never runs on C:\
       checkouts (WinpepperUncStagingDir is only set there when the project
       lives on a UNC path). -->
  <Target Name="_WinpepperCopyMsiToArtifacts"
          AfterTargets="Build"
          DependsOnTargets="SignArtifacts"
          Condition="'$(WinpepperUncStagingDir)' != ''">
    <Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFiles="$(MSBuildThisFileDirectory)..\artifacts\$(TargetFileName)" />
    <Message Importance="high" Text="packaging: copied $(TargetFileName) from UNC staging to artifacts\" />
  </Target>
</Project>
