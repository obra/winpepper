<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?define ProductName = "Winpepper" ?>
  <?define Manufacturer = "Winpepper" ?>
  <?define UpgradeCodeGuid = "6c0b2a36-9d4f-44cf-9a3e-a3a4f0c1ed01" ?>

  <Package Name="$(ProductName)"
           Manufacturer="$(Manufacturer)"
           Version="!(bind.FileVersion.WinpepperExe)"
           UpgradeCode="$(UpgradeCodeGuid)"
           Scope="perUser"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="Winpepper local dictation for Windows"
                        Manufacturer="$(Manufacturer)" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Spec §11: AllowDowngrades=no. (Spec's Schedule=afterInstallInitialize
         is deviated from — see the Schedule comment below.) -->
    <!-- AllowSameVersionUpgrades=yes: ProductVersion is the NBGV 4-part file
         version (0.6.2.<height>), but FindRelatedProducts compares only the
         first THREE fields of ProductVersion. Every 0.6.2.* dev build is
         therefore "equal", so the default earlier-versions-only Upgrade row
         (VersionMax exclusive) never detected the previously installed build
         and products accumulated side-by-side in ARP (22 stale records were
         observed on a dev machine). Setting this makes the VersionMax bound
         inclusive so an equal x.y.z triplet is removed by the major upgrade.
         This requires an auto-generated ProductCode, which holds here: Package
         has no ProductCode attribute, and WiX v5 defaults it to "*" (fresh
         GUID per build). Caveat: MSI still cannot order builds within the same
         x.y.z triplet, so an older 0.6.2.* build can also "upgrade" a newer
         one — acceptable for dev-height builds; real downgrades across x.y.z
         are still blocked by AllowDowngrades=no. -->
    <!-- Schedule=afterInstallExecute (deviation from spec §11's
         afterInstallInitialize). Same-version upgrades lose files under any
         EARLY RemoveExistingProducts schedule: at costing (which always
         precedes REP), MSI finds the outgoing product's component registered
         over the same keyfile path and, when the existing keyfile wins the
         version comparison, logs "Disallowing installation of component ...
         higher versioned keyfile exists" and generates no copy op. Two
         WinAppSDK DLLs (Microsoft.ui.xaml.dll, Microsoft.UI.Xaml.Phone.dll)
         deterministically lose that comparison — they carry the 84-entry
         Language metadata that ICE03 is suppressed for, which poisons the
         equal-version tie-break. With REP scheduled early
         (afterInstallInitialize AND afterInstallValidate — both observed),
         the old product is then removed BEFORE the new product registers as
         a client of those components, so the only copy of each keyfile is
         deleted and never re-copied. The check keys on the keyfile PATH, not
         the component GUID (fresh per-build heat GUIDs were tried and the
         disallow still fired), so no costing-side fix exists.
         afterInstallExecute runs REP AFTER the new product has installed its
         files and registered as a client of every shared component: the old
         product's removal then decrements component refcounts (2 -> 1)
         instead of deleting keyfiles, and the disallowed components keep the
         existing identical-bytes DLLs. Requires stable component GUIDs
         across builds — heat's path-stable autogenerated GUIDs plus the
         fixed hand-authored GUIDs below provide that. Bonus vs the early
         schedules: REP stays inside the install transaction, so a failed
         upgrade rolls back to the old product instead of leaving nothing. -->
    <MajorUpgrade AllowDowngrades="no"
                  AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallExecute"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- ARP entry. -->
    <Property Id="ARPPRODUCTICON" Value="WinpepperIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/obra/winpepper" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Icon Id="WinpepperIcon" SourceFile="$(AppPublishDir)\Assets\AppIcon.ico" />

    <!-- Deliberately no OS-version LaunchCondition: the installer imposes
         no Windows version floor. The app stack (WinAppSDK, .NET 9, ONNX
         Runtime, Win32 capture/injection APIs) runs on every supported
         Windows release, so gating on a build number would only exclude
         machines the software would run on fine. -->

    <Feature Id="MainFeature" Title="$(ProductName)" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="HarvestedFiles" />
      <ComponentGroupRef Id="WinpepperExeAliasGroup" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="AutostartRunKey" />
      <ComponentRef Id="HKCUVersionStamp" />
    </Feature>

    <!-- Per-user install: %LOCALAPPDATA%\Programs\Winpepper (the VS Code /
         Squirrel per-user convention). Scope="perUser" installs without
         elevation; the Installer resolves LocalAppDataFolder to the invoking
         user's %LOCALAPPDATA%. Nesting under LocalAppDataFolder is supported;
         note that file components under a per-user profile dir raise ICE38
         (error) + ICE64/ICE91 (warnings) at build time, which is inherent to
         per-user installs and is handled by suppressing those ICEs in the
         wixproj (Step 6d), not by scope, which cannot affect static ICEs. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="$(ProductName)" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="WinpepperStartMenu" Name="$(ProductName)" />
    </StandardDirectory>

    <!-- Start menu shortcut. -->
    <Component Id="StartMenuShortcut"
               Directory="WinpepperStartMenu"
               Guid="6c0b2a36-9d4f-44cf-9a3e-a3a4f0c1ed03">
      <Shortcut Id="WinpepperShortcut"
                Name="Winpepper"
                Description="Local dictation for Windows"
                Target="[#WinpepperExe]"
                WorkingDirectory="INSTALLFOLDER"
                Icon="WinpepperIcon" />
      <RemoveFolder Id="RemoveWinpepperStartMenu" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Winpepper\InstalledShortcuts"
                     Name="StartMenu"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- WINPEPPER_RUNKEY_PREEXISTS: snapshot of the autostart Run value taken
         by AppSearch, which runs BEFORE RemoveExistingProducts deletes the old
         product's copy of the key. This is what lets the AutostartRunKey
         component condition below distinguish "user opted out" (key absent
         pre-upgrade) from "key removed by the upgrade itself". -->
    <Property Id="WINPEPPER_RUNKEY_PREEXISTS" Secure="yes">
      <RegistrySearch Id="WinpepperRunKeySearch"
                      Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Run"
                      Name="Winpepper"
                      Type="raw" />
    </Property>

    <!-- Autostart Run key. Spec §7.7 intent: seed autostart on fresh install,
         never stomp a user's opt-out. The app manages the key at runtime
         (Winpepper.Platform AutostartRegistry, toggled from RecordingPage and
         persisted to settings.json) but does NOT reconcile it at startup, so
         the MSI must preserve user intent itself.
         The old write-once condition (NOT WIX_UPGRADE_DETECTED) lost the key
         on every major upgrade: the outgoing product's uninstall deletes it
         and the new product declined to rewrite it. Now the pre-upgrade
         snapshot (WINPEPPER_RUNKEY_PREEXISTS above) re-authorizes the write.
         Semantics:
         - Fresh install: key written (autostart on by default).
         - Upgrade, key present pre-upgrade: key rewritten (survives).
         - Upgrade after user removed the key (app toggle or manual): stays
           absent — opt-out respected across upgrades.
         - Uninstall: key removed (normal component teardown).
         - Repair of an install whose condition was true: key restored.
         WiX v5 requires the conditional form as a Component @Condition attribute;
         the legacy <Condition> child element was removed in v5. -->
    <Component Id="AutostartRunKey"
               Directory="INSTALLFOLDER"
               Guid="6c0b2a36-9d4f-44cf-9a3e-a3a4f0c1ed04"
               Condition="(NOT WIX_UPGRADE_DETECTED OR WINPEPPER_RUNKEY_PREEXISTS) AND NOT UPGRADINGPRODUCTCODE">
      <RegistryValue Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="Winpepper"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]Winpepper.exe&quot; --tray"
                     KeyPath="yes" />
    </Component>

    <!-- A marker so future MSIs can detect a prior install location. Per-user
         install => the stamp lives in HKCU (writing HKLM would require
         elevation). The autostart Run key below is already HKCU. NEW GUID:
         Windows Installer component rules require a fresh component code when a
         resource's keypath root changes (HKLM -> HKCU). Reusing the old GUID
         across the per-machine->per-user boundary would risk cross-context
         identity collision if a prior per-machine install is still present. -->
    <Component Id="HKCUVersionStamp"
               Directory="INSTALLFOLDER"
               Guid="17b56ae2-a240-4026-82cf-62258ca9a839">
      <RegistryValue Root="HKCU"
                     Key="Software\Winpepper"
                     Name="InstallVersion"
                     Type="string"
                     Value="!(bind.FileVersion.WinpepperExe)"
                     KeyPath="yes" />
      <RegistryValue Root="HKCU"
                     Key="Software\Winpepper"
                     Name="InstallDir"
                     Type="string"
                     Value="[INSTALLFOLDER]" />
    </Component>

    <!-- Harvest publish output. The HarvestDirectory item is added in Task 7;
         the ComponentGroup it generates is referenced above by id "HarvestedFiles". -->

    <!-- DirectX 12 warning (Task 8) and WinAppSDK bootstrapper (Task 8) are
         injected by separate Task 8 edits below. Keep this region stable. -->

    <!-- Capability probe binary. -->
    <Binary Id="D3D12ProbeBinary" SourceFile="$(var.D3D12ProbeExe)" />
    <Binary Id="WinAppSdkBootstrapperBinary" SourceFile="$(var.WinAppSdkBootstrapper)" />

    <!-- Best-effort capability probe. It writes %TEMP%\winpepper-probe.txt
         (DX12 presence, WinAppSDK presence, Windows build) purely as a
         support/diagnostics artifact; nothing in the install consumes it.
         Return="ignore" keeps any probe failure nonfatal. -->
    <CustomAction Id="RunCapabilityProbe"
                  BinaryRef="D3D12ProbeBinary"
                  ExeCommand=""
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- Install the WinAppSDK runtime if absent. -->
    <CustomAction Id="InstallWinAppSdk"
                  BinaryRef="WinAppSdkBootstrapperBinary"
                  ExeCommand="--quiet"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- The probe runs in BOTH sequences so the diagnostics file exists under
         interactive (UI) AND silent (/qn) installs. Anchoring before
         LaunchConditions keeps it early; nothing downstream depends on it. -->
    <InstallUISequence>
      <Custom Action="RunCapabilityProbe" Before="LaunchConditions" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="RunCapabilityProbe" Before="LaunchConditions" />
      <!-- InstallWinAppSdk CA gated FALSE: Winpepper.App is published with
           self-contained true, so the WinAppSDK runtime DLLs ship inside
           the install folder. Re-enabling it needs (a) a real
           WindowsAppRuntimeInstall-x64.exe in packaging/bootstrapper/ and
           (b) a script-free detection condition, e.g. an AppSearch
           RegistrySearch on HKLM\SOFTWARE\Microsoft\WindowsAppRuntime\
           Installed\1.6 (do NOT reintroduce a VBScript CA — see issue #29). -->
      <Custom Action="InstallWinAppSdk"
              Before="InstallFinalize"
              Condition="0=1" />
    </InstallExecuteSequence>

    <!-- WixUI_Minimal (no directory-browse). WixUI_InstallDir's Browse dialog
         could retarget install to Program Files and reintroduce UAC in a
         per-user package; the install location is fixed by convention. -->
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- Launch-on-finish. A fresh MSI install must land the user in first-run
         onboarding (AppShell shows it whenever Settings.OnboardingCompleted is
         false), so the exit dialog offers a "Launch Winpepper" checkbox,
         checked by default. WixShellExec (WixToolset.Util.wixext, binary id
         Wix4UtilCA_X64 for the NetFx-era prefix the v5 wixlib still uses)
         ShellExecutes the just-installed exe impersonated — as the installing
         user, never elevated. No launch args: the Run key's tray switch is
         for logon; the install-finish path must show the window so onboarding
         appears. Return="ignore": a failed ShellExecute must not turn the
         success exit dialog into an error. Never fires on silent (/qn)
         installs or maintenance — there is no ExitDialog without full UI,
         and NOT Installed gates repair/modify. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Winpepper" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#WinpepperExe]" />
    <CustomAction Id="LaunchWinpepper"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Impersonate="yes"
                  Return="ignore" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchWinpepper" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- Real Apache-2.0 license text for WixUI_Minimal's combined welcome/EULA dialog;
         without this override WiX shows its lorem-ipsum placeholder.
         Path is relative to the project directory (packaging/), same as the
         ScriptSourceFile references above. -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>

  <!-- Override harvested file id for the main exe so wxs can bind to it
       via [#WinpepperExe] (Shortcut Target) and !(bind.FileVersion.WinpepperExe). -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- Fresh GUID: the exe's install location moved ProgramFiles64Folder ->
           LocalAppDataFolder\Programs\Winpepper; component rules require a new
           component code when a resource's target location changes. -->
      <Component Id="WinpepperExeAlias" Guid="caac54b1-ecba-402d-af89-eadebf23834c" Bitness="always64">
        <File Id="WinpepperExe"
              Source="$(var.AppPublishDir)\Winpepper.exe"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <ComponentGroup Id="WinpepperExeAliasGroup">
      <ComponentRef Id="WinpepperExeAlias" />
    </ComponentGroup>
  </Fragment>
</Wix>
