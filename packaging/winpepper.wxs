<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?define ProductName = "Winpepper" ?>
  <?define Manufacturer = "Winpepper" ?>
  <?define UpgradeCodeGuid = "6c0b2a36-9d4f-44cf-9a3e-a3a4f0c1ed01" ?>

  <Package Name="$(ProductName)"
           Manufacturer="$(Manufacturer)"
           Version="!(bind.FileVersion.WinpepperExe)"
           UpgradeCode="$(UpgradeCodeGuid)"
           Scope="perUser"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="Winpepper local dictation for Windows 11"
                        Manufacturer="$(Manufacturer)" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Spec §11: AllowDowngrades=no, Schedule=afterInstallInitialize. -->
    <!-- AllowSameVersionUpgrades=yes: ProductVersion is the NBGV 4-part file
         version (0.6.2.<height>), but FindRelatedProducts compares only the
         first THREE fields of ProductVersion. Every 0.6.2.* dev build is
         therefore "equal", so the default earlier-versions-only Upgrade row
         (VersionMax exclusive) never detected the previously installed build
         and products accumulated side-by-side in ARP (22 stale records were
         observed on a dev machine). Setting this makes the VersionMax bound
         inclusive so an equal x.y.z triplet is removed by the major upgrade.
         This requires an auto-generated ProductCode, which holds here: Package
         has no ProductCode attribute, and WiX v5 defaults it to "*" (fresh
         GUID per build). Caveat: MSI still cannot order builds within the same
         x.y.z triplet, so an older 0.6.2.* build can also "upgrade" a newer
         one — acceptable for dev-height builds; real downgrades across x.y.z
         are still blocked by AllowDowngrades=no. -->
    <MajorUpgrade AllowDowngrades="no"
                  AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- ARP entry. -->
    <Property Id="ARPPRODUCTICON" Value="WinpepperIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/obra/winpepper" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Icon Id="WinpepperIcon" SourceFile="$(AppPublishDir)\Assets\AppIcon.ico" />

    <!-- Spec §11: Windows 11 22H2+ via LaunchCondition. Build 22621 = 22H2.
         VersionNT64 >= 1000 enforces Windows 10/11 x64; the build-number gate (MSI_WIN_BUILD,
         populated by the AppSearch registry search below from HKLM\…\CurrentBuildNumber)
         is the real 22H2+ check. MSI string comparison on >= is lexicographic, so this works correctly
         only as long as CurrentBuildNumber is always a same-width number string — which it
         is on Windows 10/11 (5 digits). WindowsBuild is NOT a stock MSI/WiX property and
         must not be used here. -->
    <!-- Drop VersionNT/VersionNT64 — Windows reports them as 603 (Win 8.1 compat
         shim) on Win 10/11+ regardless of actual version. MSI_WIN_BUILD from our
         capability probe reads CurrentBuildNumber from the registry and is the
         only reliable signal. -->
    <Launch Condition="Installed OR MSI_WIN_BUILD &gt;= 22621"
            Message="[ProductName] requires Windows 11 22H2 (build 22621) or newer." />

    <Feature Id="MainFeature" Title="$(ProductName)" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="HarvestedFiles" />
      <ComponentGroupRef Id="WinpepperExeAliasGroup" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="AutostartRunKey" />
      <ComponentRef Id="HKCUVersionStamp" />
    </Feature>

    <!-- Per-user install: %LOCALAPPDATA%\Programs\Winpepper (the VS Code /
         Squirrel per-user convention). Scope="perUser" installs without
         elevation; the Installer resolves LocalAppDataFolder to the invoking
         user's %LOCALAPPDATA%. Nesting under LocalAppDataFolder is supported;
         note that file components under a per-user profile dir raise ICE38
         (error) + ICE64/ICE91 (warnings) at build time, which is inherent to
         per-user installs and is handled by suppressing those ICEs in the
         wixproj (Step 6d), not by scope, which cannot affect static ICEs. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="$(ProductName)" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="WinpepperStartMenu" Name="$(ProductName)" />
    </StandardDirectory>

    <!-- Start menu shortcut. -->
    <Component Id="StartMenuShortcut"
               Directory="WinpepperStartMenu"
               Guid="6c0b2a36-9d4f-44cf-9a3e-a3a4f0c1ed03">
      <Shortcut Id="WinpepperShortcut"
                Name="Winpepper"
                Description="Local dictation for Windows 11"
                Target="[#WinpepperExe]"
                WorkingDirectory="INSTALLFOLDER"
                Icon="WinpepperIcon" />
      <RemoveFolder Id="RemoveWinpepperStartMenu" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\Winpepper\InstalledShortcuts"
                     Name="StartMenu"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Autostart Run key — fresh install only (spec §7.7).
         WiX v5 requires the conditional form as a Component @Condition attribute;
         the legacy <Condition> child element was removed in v5. -->
    <Component Id="AutostartRunKey"
               Directory="INSTALLFOLDER"
               Guid="6c0b2a36-9d4f-44cf-9a3e-a3a4f0c1ed04"
               Condition="NOT WIX_UPGRADE_DETECTED AND NOT UPGRADINGPRODUCTCODE">
      <RegistryValue Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="Winpepper"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]Winpepper.exe&quot; --tray"
                     KeyPath="yes" />
    </Component>

    <!-- A marker so future MSIs can detect a prior install location. Per-user
         install => the stamp lives in HKCU (writing HKLM would require
         elevation). The autostart Run key below is already HKCU. NEW GUID:
         Windows Installer component rules require a fresh component code when a
         resource's keypath root changes (HKLM -> HKCU). Reusing the old GUID
         across the per-machine->per-user boundary would risk cross-context
         identity collision if a prior per-machine install is still present. -->
    <Component Id="HKCUVersionStamp"
               Directory="INSTALLFOLDER"
               Guid="17b56ae2-a240-4026-82cf-62258ca9a839">
      <RegistryValue Root="HKCU"
                     Key="Software\Winpepper"
                     Name="InstallVersion"
                     Type="string"
                     Value="!(bind.FileVersion.WinpepperExe)"
                     KeyPath="yes" />
      <RegistryValue Root="HKCU"
                     Key="Software\Winpepper"
                     Name="InstallDir"
                     Type="string"
                     Value="[INSTALLFOLDER]" />
    </Component>

    <!-- Harvest publish output. The HarvestDirectory item is added in Task 7;
         the ComponentGroup it generates is referenced above by id "HarvestedFiles". -->

    <!-- DirectX 12 warning (Task 8) and WinAppSDK bootstrapper (Task 8) are
         injected by separate Task 8 edits below. Keep this region stable. -->

    <!-- Capability probe binary. -->
    <Binary Id="D3D12ProbeBinary" SourceFile="$(var.D3D12ProbeExe)" />
    <Binary Id="WinAppSdkBootstrapperBinary" SourceFile="$(var.WinAppSdkBootstrapper)" />

    <!-- MSI_WIN_BUILD feeds the launch condition above. It is populated by the
         standard AppSearch action (sequenced before LaunchConditions in both the
         UI and execute sequences), which needs no script engine. It used to be
         copied out of the capability probe's output file by a VBScript custom
         action; that failed with MSI error 2738 on Windows images that ship
         without vbscript.dll (e.g. Windows Sandbox, hardened images), which made
         the launch condition fire and the install abort with 1603 (issue #29).
         CurrentBuildNumber is REG_SZ, so Type="raw" yields the bare digit string
         and the lexicographic >= comparison caveat documented above still applies.
         Secure="yes" makes the property transferable from the immediate to the
         deferred context if a future CA ever needs it there. -->
    <Property Id="MSI_WIN_BUILD" Secure="yes">
      <RegistrySearch Id="MsiWinBuildRegSearch"
                      Root="HKLM"
                      Key="Software\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <!-- Best-effort capability probe. It writes %TEMP%\winpepper-probe.txt
         (DX12 presence, WinAppSDK presence, Windows build) purely as a
         support/diagnostics artifact; nothing in the install consumes it.
         Return="ignore" keeps any probe failure nonfatal. -->
    <CustomAction Id="RunCapabilityProbe"
                  BinaryRef="D3D12ProbeBinary"
                  ExeCommand=""
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <!-- Install the WinAppSDK runtime if absent. -->
    <CustomAction Id="InstallWinAppSdk"
                  BinaryRef="WinAppSdkBootstrapperBinary"
                  ExeCommand="--quiet"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- The probe runs in BOTH sequences so the diagnostics file exists under
         interactive (UI) AND silent (/qn) installs. It is anchored before
         LaunchConditions only so it still runs (and leaves its artifact) when
         the OS gate aborts the install; nothing downstream depends on it. -->
    <InstallUISequence>
      <Custom Action="RunCapabilityProbe" Before="LaunchConditions" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="RunCapabilityProbe" Before="LaunchConditions" />
      <!-- InstallWinAppSdk CA gated FALSE: Winpepper.App is published with
           self-contained true, so the WinAppSDK runtime DLLs ship inside
           the install folder. Re-enabling it needs (a) a real
           WindowsAppRuntimeInstall-x64.exe in packaging/bootstrapper/ and
           (b) a script-free detection condition, e.g. an AppSearch
           RegistrySearch on HKLM\SOFTWARE\Microsoft\WindowsAppRuntime\
           Installed\1.6 (do NOT reintroduce a VBScript CA — see issue #29). -->
      <Custom Action="InstallWinAppSdk"
              Before="InstallFinalize"
              Condition="0=1" />
    </InstallExecuteSequence>

    <!-- WixUI_Minimal (no directory-browse). WixUI_InstallDir's Browse dialog
         could retarget install to Program Files and reintroduce UAC in a
         per-user package; the install location is fixed by convention. -->
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- Real Apache-2.0 license text for WixUI_Minimal's combined welcome/EULA dialog;
         without this override WiX shows its lorem-ipsum placeholder.
         Path is relative to the project directory (packaging/), same as the
         ScriptSourceFile references above. -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>

  <!-- Override harvested file id for the main exe so wxs can bind to it
       via [#WinpepperExe] (Shortcut Target) and !(bind.FileVersion.WinpepperExe). -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <!-- Fresh GUID: the exe's install location moved ProgramFiles64Folder ->
           LocalAppDataFolder\Programs\Winpepper; component rules require a new
           component code when a resource's target location changes. -->
      <Component Id="WinpepperExeAlias" Guid="caac54b1-ecba-402d-af89-eadebf23834c" Bitness="always64">
        <File Id="WinpepperExe"
              Source="$(var.AppPublishDir)\Winpepper.exe"
              KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <ComponentGroup Id="WinpepperExeAliasGroup">
      <ComponentRef Id="WinpepperExeAlias" />
    </ComponentGroup>
  </Fragment>
</Wix>
