<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winpepper.App.Views.Controls.HotkeyRecorderBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="4">
        <TextBlock x:Name="LabelBlock" Text="Hotkey" />
        <Border BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
            <Grid>
                <TextBlock x:Name="ChordText" AutomationProperties.AutomationId="HotkeyChordLabel" Text="(press a chord)" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <Button x:Name="RecordButton" AutomationProperties.AutomationId="HotkeyRecordButton" Content="Record" HorizontalAlignment="Right" Click="OnRecordClick" />
            </Grid>
        </Border>
        <TextBlock x:Name="ErrorText" Foreground="OrangeRed" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
