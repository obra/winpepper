<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Winpepper.App.Views.Controls.HotkeyRecorderBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="6">
        <TextBlock x:Name="LabelBlock" Text="Hotkey" />
        <TextBlock x:Name="HintBlock"
                   Visibility="Collapsed"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Keycap-style chip showing the current chord -->
            <Border Grid.Column="0"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,4"
                    MinWidth="160"
                    MinHeight="32"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <TextBlock x:Name="ChordText"
                           AutomationProperties.AutomationId="HotkeyChordLabel"
                           Text="(press a chord)"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="RecordButton" AutomationProperties.AutomationId="HotkeyRecordButton" Content="Set hotkey" Click="OnRecordClick" />
                <Button x:Name="CancelButton" AutomationProperties.AutomationId="HotkeyCancelButton" Content="Cancel" Click="OnCancelClick" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ErrorText"
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </StackPanel>
</UserControl>
