<Page x:Class="Winpepper.App.Views.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:logging="using:Winpepper.Core.Logging">
    <Grid Padding="24" RowSpacing="12" MaxWidth="800" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Diagnostics" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock Grid.Row="1"
                   Text="Live log tail and tools for reporting problems."
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="CopyBundleBtn" AutomationProperties.AutomationId="DiagnosticsCopyBundleButton" Click="OnCopyBundle" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8C8;" FontSize="16" />
                    <TextBlock Text="Copy diagnostics bundle" />
                </StackPanel>
            </Button>
            <Button x:Name="OpenLogFolderBtn" AutomationProperties.AutomationId="DiagnosticsOpenLogFolderButton" Click="OnOpenLogFolder">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE838;" FontSize="16" />
                    <TextBlock Text="Open log folder" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="LastBundleLabel"
                       AutomationProperties.AutomationId="DiagnosticsLastBundleLabel"
                       VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="8">
            <ListView x:Name="TailList"
                      AutomationProperties.AutomationId="DiagnosticsTailList"
                      ItemsSource="{x:Bind ViewModel.Tail, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="logging:LogTailEntry">
                        <Grid ColumnSpacing="10" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind TimestampLocal}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Level}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Message}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="Tail keeps the most recent 2000 log lines. Audio is never included in the diagnostics bundle."
                   Style="{ThemeResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </Grid>
</Page>
