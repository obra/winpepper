<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Winpepper.App.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Winpepper.App.Views.Controls">
    <ScrollViewer>
        <StackPanel MaxWidth="720" HorizontalAlignment="Center" Spacing="20" Padding="24,40,24,24">

            <!-- Hero -->
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Image Source="ms-appx:///Assets/Square150x150Logo.png" Width="72" Height="72" HorizontalAlignment="Center" />
                <TextBlock Text="Welcome to Winpepper"
                           Style="{ThemeResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Fast, private dictation that runs entirely on your PC — talk instead of type, in any app."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           MaxWidth="440" />
            </StackPanel>

            <!-- Step progress dots (recolored from code-behind as steps advance) -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Border x:Name="StepDot1" Background="{ThemeResource AccentFillColorDefaultBrush}" Width="10" Height="10" CornerRadius="5" />
                <Border x:Name="StepDot2" Background="{ThemeResource ControlStrokeColorDefaultBrush}" Width="10" Height="10" CornerRadius="5" />
                <Border x:Name="StepDot3" Background="{ThemeResource ControlStrokeColorDefaultBrush}" Width="10" Height="10" CornerRadius="5" />
                <Border x:Name="StepDot4" Background="{ThemeResource ControlStrokeColorDefaultBrush}" Width="10" Height="10" CornerRadius="5" />
            </StackPanel>

            <!-- One panel per step; code-behind toggles visibility -->
            <Grid>
                <StackPanel x:Name="PickMicPanel" Visibility="Visible" Spacing="8">
                    <TextBlock Text="Step 1 of 4"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE720;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Pick your microphone" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Choose the input device Winpepper should listen to. Say something — the level meter should move."
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <ComboBox x:Name="MicCombo" AutomationProperties.AutomationId="OnboardingMicCombo" HorizontalAlignment="Stretch" PlaceholderText="Select an input device" />
                            <TextBlock TextWrapping="Wrap"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="While Winpepper runs, the microphone stays warm so your first words are never clipped — the mic-in-use indicator will stay on. You can turn this off in Settings." />
                            <ProgressBar x:Name="LevelMeter" AutomationProperties.AutomationId="OnboardingLevelMeter" Minimum="0" Maximum="1" Height="6" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="HotkeyPanel" Visibility="Collapsed" Spacing="8">
                    <TextBlock Text="Step 2 of 4"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE765;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Record your hotkeys" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="These shortcuts work anywhere in Windows: hold one to dictate while pressed, or tap the other to toggle recording."
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <controls:HotkeyRecorderBox x:Name="HoldBox" Label="Hold to record"
                                                        Hint="Choose Space to type normally. Holding it for 300 ms also starts recording and leaves one Space typed."
                                                        AutomationProperties.AutomationId="OnboardingHoldHotkeyBox" />
                            <controls:HotkeyRecorderBox x:Name="ToggleBox" Label="Toggle to record" AutomationProperties.AutomationId="OnboardingToggleHotkeyBox" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DownloadPanel" Visibility="Collapsed" Spacing="8">
                    <TextBlock Text="Step 3 of 4"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Choose your models"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Winpepper downloads speech models once, then works fully offline. You can change any of this later in Settings › Models."
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" />

                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                        <Run Text="Speech model" FontWeight="SemiBold" />
                        <Run Text=" — transcribes while you speak. Pick one." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="EnglishCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <RadioButton x:Name="EnglishRadio" GroupName="SpeechModel" IsChecked="True"
                                         AutomationProperties.AutomationId="OnboardingSpeechEnglishRadio">
                                <StackPanel Spacing="3">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="English" FontWeight="SemiBold" />
                                        <Border Background="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}"
                                                CornerRadius="10" Padding="9,2">
                                            <TextBlock Text="Recommended" Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Best English accuracy."
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="EnglishSizeText" FontWeight="SemiBold" Margin="0,6,0,0"
                                               Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </RadioButton>
                        </Border>
                        <Border Grid.Column="1" x:Name="MultilingualCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <RadioButton x:Name="MultilingualRadio" GroupName="SpeechModel"
                                         AutomationProperties.AutomationId="OnboardingSpeechMultilingualRadio">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Multilingual" FontWeight="SemiBold" />
                                    <TextBlock Text="40 languages, auto-detected. Slightly lower English accuracy."
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="MultilingualSizeText" FontWeight="SemiBold" Margin="0,6,0,0"
                                               Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </RadioButton>
                        </Border>
                    </Grid>

                    <TextBlock Text="Options" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <CheckBox x:Name="BackupCheck" AutomationProperties.AutomationId="OnboardingBackupModelCheckBox">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Backup speech model" FontWeight="SemiBold" />
                                    <TextBlock Text="Slower — transcribes after you stop speaking. Steps in automatically if the main speech engine ever has trouble."
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="BackupSizeText"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </CheckBox>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <CheckBox x:Name="CleanupCheck" AutomationProperties.AutomationId="OnboardingCleanupModelCheckBox">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Text cleanup" FontWeight="SemiBold" />
                                    <TextBlock Text="Tidies what you dictate — punctuation, capitalization, and filler words — before it's typed into your apps."
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" x:Name="CleanupSizeText"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </CheckBox>
                    </Border>

                    <TextBlock Text="Downloads happen in the background — you can keep setting up while they run."
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="TotalDownloadText"
                               AutomationProperties.AutomationId="OnboardingTotalDownloadText" />
                </StackPanel>

                <StackPanel x:Name="TestPanel" Visibility="Collapsed" Spacing="8">
                    <TextBlock Text="Step 4 of 4"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE768;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Try it" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Click into the box below, hold your hotkey, and say a sentence."
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="DownloadStatusText"
                                       AutomationProperties.AutomationId="OnboardingDownloadStatusText"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressBar x:Name="DownloadProgress" AutomationProperties.AutomationId="OnboardingDownloadProgressBar" Minimum="0" Maximum="100" Visibility="Collapsed" />
                            <TextBlock x:Name="DownloadErrorText"
                                       AutomationProperties.AutomationId="OnboardingDownloadErrorText"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                            <Button x:Name="RetryDownloadButton"
                                    AutomationProperties.AutomationId="OnboardingRetryDownloadButton"
                                    Content="Retry download" Visibility="Collapsed" Click="OnRetryDownload" />
                            <TextBox x:Name="TestBox" AutomationProperties.AutomationId="OnboardingTestTextBox" PlaceholderText="Dictate into me..." Height="100" AcceptsReturn="True" TextWrapping="Wrap" />
                            <CheckBox x:Name="TestDoneCheck" AutomationProperties.AutomationId="OnboardingTestDoneCheckBox" Content="That worked." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DonePanel" Visibility="Collapsed" Spacing="8">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="24">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="36" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="You're all set" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="Winpepper is now running in the tray. Click the icon or press your hotkey to start dictating."
                                       Style="{ThemeResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="AdvanceButton" AutomationProperties.AutomationId="OnboardingNextButton" Content="Next" Click="OnAdvance" Style="{StaticResource AccentButtonStyle}" MinWidth="120" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
