<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Winpepper.App.Views.StatusPillWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The pill IS the window: one uniform dark surface edge-to-edge, corners
         rounded by DWM (DWMWCP_ROUND) and the system drop shadow disabled
         (DWMNCRP_DISABLED). No shaped-window / colour-key / region tricks —
         all three proved unreliable on layered windows.
         PointerPressed on the root drives the PENDING click-to-paste state;
         DotScale is animated by the code-behind (voice level / thinking). -->
    <Grid Background="#FF202020" Padding="16,8"
          PointerPressed="OnRootPointerPressed"
          ColumnSpacing="10" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#FFEF4444"
                 VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="DotScale" ScaleX="1.0" ScaleY="1.0" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <!-- Live voice meter: bars are generated in code-behind (BuildMeterBars)
             and animated per 100ms tick from VoiceMeter.BarHeights — a cheap
             centre-weighted wave with per-bar shimmer and a green->amber->red
             height gradient. Collapsed outside Recording. -->
        <StackPanel x:Name="MeterPanel"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center"
                    Visibility="Collapsed" />
        <TextBlock x:Name="StatusText"
                   Grid.Column="2"
                   Foreground="White"
                   FontSize="13"
                   VerticalAlignment="Center"
                   Text="Recording..."
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="ElapsedText"
                   Grid.Column="3"
                   Foreground="#AAFFFFFF"
                   FontSize="12"
                   VerticalAlignment="Center"
                   Text="0 s" />
    </Grid>
</Window>
