<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Winpepper.Models</RootNamespace>
    <AssemblyName>Winpepper.Models</AssemblyName>
    <!-- keep win-x64 in restore assets so an RID-less restore (e.g. the MSI wixproj) doesn't clobber `dotnet publish -r win-x64` assets (NETSDK1047) -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Winpepper.Core\Winpepper.Core.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
