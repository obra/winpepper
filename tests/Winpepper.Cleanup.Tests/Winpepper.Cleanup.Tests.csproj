<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TargetFrameworks>net9.0;net9.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Winpepper.Cleanup\Winpepper.Cleanup.csproj" />
    <ProjectReference Include="..\..\src\Winpepper.Corrections\Winpepper.Corrections.csproj" />
    <ProjectReference Include="..\..\src\Winpepper.Models\Winpepper.Models.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Linked-file rule (docs/plans/2026-07-26-asr-eval-framework.md): pure-logic
         bench files under scripts/ are BCL-only and compiled into this test
         project so the Linux gate covers them. -->
    <Compile Include="..\..\scripts\cleanup-latency-bench\CleanupBenchArgs.cs" Link="Bench\CleanupBenchArgs.cs" />
    <Compile Include="..\..\scripts\cleanup-latency-bench\CleanupBenchStatements.cs" Link="Bench\CleanupBenchStatements.cs" />
    <Compile Include="..\..\scripts\cleanup-latency-bench\CleanupBenchResults.cs" Link="Bench\CleanupBenchResults.cs" />
    <Compile Include="..\..\scripts\cleanup-latency-bench\CleanupEvalStatements.cs" Link="Bench\CleanupEvalStatements.cs" />
  </ItemGroup>
</Project>
