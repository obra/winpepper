<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- tbc0: dual-target so the real-Windows contention test (WindowContextPrefetchAsrContentionTests,
         #if WINDOWS) runs on the gate's windows TFM; net9.0 keeps the Linux-visible tests. -->
    <!-- Directory.Build.props sets TargetFramework=net9.0 BEFORE this file's body is read;
         clear it first (same convention as Winpepper.Platform.Tests) or a bare
         `dotnet build` only builds net9.0. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net9.0;net9.0-windows10.0.19041.0</TargetFrameworks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Winpepper.Core\Winpepper.Core.csproj" />
    <ProjectReference Include="..\..\src\Winpepper.Corrections\Winpepper.Corrections.csproj" />
    <ProjectReference Include="..\..\src\Winpepper.Models\Winpepper.Models.csproj" />
    <ProjectReference Include="..\..\src\Winpepper.Asr\Winpepper.Asr.csproj" />
    <ProjectReference Include="..\..\src\Winpepper.Platform\Winpepper.Platform.csproj" />
    <ProjectReference Include="..\..\src\Winpepper.Cleanup\Winpepper.Cleanup.csproj" />
    <!-- tbc0: real contention test spawns the real worker loop (TranscribeWorkerHost)
         as a child process — same inclusion mechanism Winpepper.Asr.Tests uses. -->
    <ProjectReference Include="..\TranscribeWorkerHost\TranscribeWorkerHost.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0-windows10.0.19041.0'">
    <!-- Shared test-owned window for the real-UIA burst test (deterministic
         read cost, no ambient-foreground dependence; windows TFM only). -->
    <Compile Include="..\Winpepper.Platform.Tests\TestInfra\TestOwnedWindow.cs" Link="TestInfra\TestOwnedWindow.cs" />
  </ItemGroup>
</Project>
